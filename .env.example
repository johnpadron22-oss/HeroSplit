# ── Supabase (client — safe to expose via VITE_) ──────────────────────────────
# Found in Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Supabase (server — SECRET, never expose in client code) ───────────────────
# Same URL as above (no VITE_ prefix — server-side only)
SUPABASE_URL=https://your-project.supabase.co
# Service role key — bypasses RLS; only used in Stripe webhook
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create a product + recurring price in Stripe dashboard, paste the price IDs here
# Monthly plan price ID (e.g. $4.99/month)
STRIPE_PRO_PRICE_ID=price_...
# Annual plan price ID (e.g. $39.99/year) — required for the annual checkout flow
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# ── App ────────────────────────────────────────────────────────────────────────
# Your deployed frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
