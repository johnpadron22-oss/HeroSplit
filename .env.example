# ── InstantDB ─────────────────────────────────────────────────────────────────
# Your InstantDB App ID (public — safe to expose in VITE_ vars)
VITE_INSTANT_APP_ID=2bcb316f-1e7d-4ade-9821-9422d2b885ea

# Your InstantDB Admin Token (SECRET — server-side only, never commit)
INSTANT_ADMIN_TOKEN=your_admin_token_here

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create a product + recurring price in Stripe dashboard, paste the price ID here
STRIPE_PRO_PRICE_ID=price_...

# ── App ────────────────────────────────────────────────────────────────────────
# Your deployed frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
